@using Nordic.Models
@using Nordic.Services
@inject CartService Cart
<div class="group relative flex flex-col justify-between">
    <!-- Image Box -->
    <div class="relative aspect-square overflow-hidden rounded-2xl bg-[#eae4d8]">
        <img src="@Product.Image" alt="@Product.Name"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        
        <!-- Badge -->
        @if (!string.IsNullOrEmpty(Product.Badge))
        {
            <span class="@GetBadgeClass(Product.Badge)">
                @Product.Badge
            </span>
        }

        <!-- Wishlist / Like Button -->
        <button @onclick="ToggleFavorite"
                class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center text-[#2c2a29] hover:scale-110 transition-all cursor-pointer shadow-sm z-10">
            <svg class="w-4 h-4 transition-colors @(IsLiked ? "fill-[#bd5d38] stroke-[#bd5d38]" : "fill-none stroke-[#2c2a29]")"
                 viewBox="0 0 24 24" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
        </button>

        <!-- Quick View Button (Hover Effect) -->
        <div
            class="absolute inset-x-0 bottom-3 flex justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-20 px-3">
            <button @onclick="OpenQuickView"
                    class="w-full bg-[#f7f4ee]/90 backdrop-blur-sm hover:bg-[#2c2a29] hover:text-[#f7f4ee] text-[#2c2a29] py-2.5 rounded-xl text-xs font-serif font-medium shadow-md transition-all cursor-pointer">
                Быстрый просмотр
            </button>
        </div>
    </div>

    <!-- Details -->
    <div class="mt-3">
        <div class="flex items-center justify-between text-[10px] text-[#8c8275]">
            <span class="uppercase tracking-wider">@Product.Category</span>
            <div class="flex items-center gap-1 font-medium text-[#2c2a29]">
                <span class="text-amber-600">★</span>
                <span>@Product.Rating</span>
                <span class="text-[#8c8275]">(@Product.ReviewsCount)</span>
            </div>
        </div>

        <h3 class="text-xs font-serif font-medium text-[#2c2a29] mt-1 line-clamp-1">
            @Product.Name
        </h3>

        <!-- Price & Add to Cart -->
        <div class="mt-2 flex items-center justify-between">
            <div class="flex items-baseline gap-1.5">
                <span class="text-xs font-serif font-bold text-[#2c2a29]">$@Product.Price</span>
                @if (Product.OriginalPrice.HasValue)
                {
                    <span class="text-[10px] line-through text-[#8c8275]">$@Product.OriginalPrice</span>
                }
            </div>

            <!-- Add to Cart with 2sec Delay Text -->
            <button @onclick="AddToCart" disabled="@isAdded"
                    class="text-xs font-serif font-medium transition-all duration-200 cursor-pointer flex items-center gap-1 @(isAdded ? "text-[#3e5c43] font-semibold" : "text-[#2c2a29] hover:text-[#bd5d38]")">
                @if (isAdded)
                {
                    <span>Добавлено ✓</span>
                }
                else
                {
                    <span>+ В корзину</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;
    [Parameter] public bool IsLiked { get; set; }
    [Parameter] public EventCallback<int> OnToggleLike { get; set; }
    [Parameter] public EventCallback<Product> OnAddToCart { get; set; }
    [Parameter] public EventCallback<Product> OnQuickView { get; set; }

    private bool isAdded = false;

    private async Task ToggleFavorite()
    {
        await OnToggleLike.InvokeAsync(Product.Id);
    }

    private async Task OpenQuickView()
    {
        await OnQuickView.InvokeAsync(Product);
    }

    private async Task AddToCart()
    {
        if (isAdded) return;

        isAdded = true;
        await OnAddToCart.InvokeAsync(Product);

        await Task.Delay(2000);
        isAdded = false;
        StateHasChanged();
    }

    private string GetBadgeClass(string badge) => badge.ToUpper() switch
    {
        "SALE" => "absolute top-3 left-3 px-2.5 py-1 text-[9px] font-bold tracking-wider uppercase rounded-md bg-[#3e5c43] text-white",
        "NEW" => "absolute top-3 left-3 px-2.5 py-1 text-[9px] font-bold tracking-wider uppercase rounded-md bg-[#bd5d38] text-white",
        "TOP" => "absolute top-3 left-3 px-2.5 py-1 text-[9px] font-bold tracking-wider uppercase rounded-md bg-[#2c2a29] text-white",
        _ => "absolute top-3 left-3 px-2.5 py-1 text-[9px] font-bold tracking-wider uppercase rounded-md bg-[#2c2a29] text-white"
    };
}