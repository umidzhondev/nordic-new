@using Nordic.Services
@inject CartService Cart
@implements IDisposable

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-hidden">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity" @onclick="Close"></div>

        <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-md bg-[#f7f4ee] shadow-2xl flex flex-col justify-between p-6 relative z-50">
                
                <!-- Header -->
                <div class="flex items-center justify-between pb-4 border-b border-[#e5dfd3]">
                    <div class="flex items-center gap-2">
                        <h2 class="text-lg font-serif font-semibold text-[#2c2a29]">Корзина</h2>
                        <span class="text-xs bg-[#eae4d8] text-[#2c2a29] font-medium px-2 py-0.5 rounded-full">
                            @Cart.TotalCount
                        </span>
                    </div>
                    <button @onclick="Close" class="text-[#8c8275] hover:text-[#2c2a29] p-1 text-xl cursor-pointer">✕</button>
                </div>

                <!-- Body (Items List) -->
                <div class="flex-1 overflow-y-auto py-4 space-y-4">
                    @if (!Cart.Items.Any())
                    {
                        <div class="h-full flex flex-col items-center justify-center text-center text-[#8c8275] space-y-2">
                            <svg class="w-12 h-12 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                            </svg>
                            <p class="text-sm font-serif">Ваша корзина пуста</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Cart.Items)
                        {
                            <div class="flex items-center gap-4 pb-4 border-b border-[#e5dfd3]">
                                <img src="@item.Product.Image" alt="@item.Product.Name" class="w-16 h-16 object-cover rounded-lg bg-[#eae4d8]" />
                                <div class="flex-1 min-w-0">
                                    <div class="flex justify-between items-start">
                                        <h4 class="text-xs font-serif font-medium text-[#2c2a29] truncate">@item.Product.Name</h4>
                                        <button @onclick="() => Cart.RemoveFromCart(item.Product.Id)" class="text-[#8c8275] hover:text-[#bd5d38] text-xs ml-2 cursor-pointer">✕</button>
                                    </div>
                                    <p class="text-[11px] text-[#8c8275] mt-0.5">$@item.Product.Price</p>

                                    <div class="flex items-center justify-between mt-2">
                                        <!-- Quantity Controls -->
                                        <div class="inline-flex items-center border border-[#e5dfd3] rounded-full bg-[#eae4d8]/40 px-2 py-0.5">
                                            <button @onclick="() => Cart.UpdateQuantity(item.Product.Id, item.Quantity - 1)" class="text-xs text-[#2c2a29] px-1.5 hover:font-bold cursor-pointer">-</button>
                                            <span class="text-xs font-mono px-2 text-[#2c2a29]">@item.Quantity</span>
                                            <button @onclick="() => Cart.UpdateQuantity(item.Product.Id, item.Quantity + 1)" class="text-xs text-[#2c2a29] px-1.5 hover:font-bold cursor-pointer">+</button>
                                        </div>
                                        <span class="text-xs font-serif font-semibold text-[#2c2a29]">$@(item.Product.Price * item.Quantity)</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Footer -->
                @if (Cart.Items.Any())
                {
                    <div class="pt-4 border-t border-[#e5dfd3] space-y-3">
                        <div class="flex justify-between text-sm font-serif font-semibold text-[#2c2a29]">
                            <span>Итого:</span>
                            <span>$@Cart.TotalPrice</span>
                        </div>
                        <button @onclick="OnCheckout" class="w-full bg-[#2c2a29] text-[#f7f4ee] py-3 rounded-xl text-xs font-medium hover:bg-[#423e3b] transition-colors cursor-pointer">
                            Оформить заказ
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}
@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnCheckoutRequested { get; set; }

    protected override void OnInitialized()
    {
        Cart.OnChange += StateHasChanged;
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task OnCheckout()
    {
        // 1. Корzinadagi mahsulotlarni tozalash (CartService'dagi metod nomi turlicha bo'lishi mumkin: Clear, ClearCart yoki Items.Clear)
        Cart.ClearCart(); // yoki Cart.ClearCart();

        await Close();
        await OnCheckoutRequested.InvokeAsync();
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
    }
}