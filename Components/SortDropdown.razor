<div class="relative inline-block text-left">
    <select value="@SelectedOption" @onchange="HandleSortChange"
            class="appearance-none bg-[#eae4d8]/50 border border-[#e5dfd3] text-[#2c2a29] text-xs font-serif rounded-lg px-3 py-2 pr-8 focus:outline-none focus:border-[#2c2a29] cursor-pointer">
        <option value="featured">По умолчанию</option>
        <option value="price-asc">Сначала дешевле</option>
        <option value="price-desc">Сначала дороже</option>
        <option value="rating">По рейтингу</option>
    </select>
    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-[#8c8275]">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </div>
</div>

@code {
    [Parameter] public string SelectedOption { get; set; } = "featured";
    [Parameter] public EventCallback<string> OnSortChanged { get; set; }

    private async Task HandleSortChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "featured";
        await OnSortChanged.InvokeAsync(value);
    }
}