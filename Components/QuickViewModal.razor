@using Nordic.Models
@using Nordic.Services
@inject CartService Cart

@if (Product != null && IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" @onclick="Close"></div>

        <!-- Modal Content -->
        <div class="relative bg-[#f7f4ee] rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-[#e5dfd3] z-10 overflow-hidden">
            <button @onclick="Close" class="absolute top-4 right-4 text-[#8c8275] hover:text-[#2c2a29] text-lg p-1 cursor-pointer">✕</button>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Image -->
                <div class="aspect-square rounded-xl overflow-hidden bg-[#eae4d8]">
                    <img src="@Product.Image" alt="@Product.Name" class="w-full h-full object-cover" />
                </div>

                <!-- Info -->
                <div class="flex flex-col justify-between">
                    <div>
                        <span class="text-[10px] uppercase font-semibold text-[#8c8275] tracking-wider">@Product.Category</span>
                        <h2 class="text-xl font-serif font-semibold text-[#2c2a29] mt-1">@Product.Name</h2>
                        
                        <div class="flex items-center gap-2 mt-2">
                            <span class="text-sm font-serif font-bold text-[#2c2a29]">$@Product.Price</span>
                            @if (Product.OriginalPrice.HasValue)
                            {
                                <span class="text-xs line-through text-[#8c8275]">$@Product.OriginalPrice</span>
                            }
                        </div>

                        <p class="text-xs text-[#8c8275] mt-4 leading-relaxed">
                            @Product.Description
                        </p>
                    </div>

                    <div class="mt-6 pt-4 border-t border-[#e5dfd3] flex gap-3">
                        <button @onclick="AddToCartAndClose" class="flex-1 bg-[#2c2a29] text-[#f7f4ee] py-2.5 rounded-xl text-xs font-medium hover:bg-[#423e3b] transition-colors cursor-pointer">
                            Добавить в корзину
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; } // <--- Mana bu juda muhim!
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Product? Product { get; set; }
    [Parameter] public EventCallback<Product?> ProductChanged { get; set; }

    private async Task Close()
    {
        Product = null;
        await ProductChanged.InvokeAsync(null);
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task AddToCartAndClose()
    {
        if (Product != null)
        {
            Cart.AddToCart(Product);
            await Close();
        }
    }
}