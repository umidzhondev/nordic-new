@using Nordic.Services

<div class="w-full lg:w-64 flex-shrink-0 space-y-8">
    
    <!-- Поиск -->
    <div>
        <h3 class="text-xs font-serif italic text-[#8c8275] mb-3">Поиск</h3>
        <div class="relative">
            <input type="text"
                   value="@SearchQuery"
                   @oninput="OnSearchInput"
                   placeholder="Название товара..."
                   class="w-full bg-transparent border-b border-[#d8d0c1] py-2 pr-8 text-sm focus:outline-none focus:border-[#2c2a29] transition-colors placeholder-[#b3a898]" />
            <svg class="w-4 h-4 absolute right-0 top-3 text-[#8c8275]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>
    </div>

    <!-- Категории -->
    <div>
        <h3 class="text-xs font-serif italic text-[#8c8275] mb-3">Категории</h3>
        <div class="space-y-1">
            @if (CategoryCounts != null)
            {
                @foreach (var category in CategoryCounts)
                {
                    <button type="button"
                            @onclick="() => SelectCategory(category.Key)"
                            class="w-full flex items-center justify-between py-2 px-3 rounded-lg text-xs font-medium transition-all text-left cursor-pointer @(SelectedCategory == category.Key ? "bg-[#eae4d8] text-[#2c2a29] font-bold" : "text-[#8c8275] hover:text-[#2c2a29] hover:bg-[#eae4d8]/50")">
                        <span>@category.Key</span>
                        <span class="text-[10px] opacity-60">@category.Value</span>
                    </button>
                }
            }
        </div>
    </div>

    <!-- Сортировка -->
    <div>
        <h3 class="text-xs font-serif italic text-[#8c8275] mb-3">Сортировка по цене</h3>
        <select value="@SelectedSort"
                @onchange="OnSortSelect"
                class="w-full bg-transparent border-b border-[#d8d0c1] py-2 text-xs focus:outline-none focus:border-[#2c2a29] cursor-pointer">
            <option value="featured">По умолчанию</option>
            <option value="price-asc">Сначала дешевле</option>
            <option value="price-desc">Сначала дороже</option>
            <option value="rating">По рейтингу</option>
        </select>
    </div>

</div>

@code {
    [Parameter] public string SearchQuery { get; set; } = "";
    [Parameter] public EventCallback<string> OnSearchChanged { get; set; }

    [Parameter] public string SelectedCategory { get; set; } = "Все";
    [Parameter] public EventCallback<string> OnCategorySelected { get; set; }

    [Parameter] public Dictionary<string, int>? CategoryCounts { get; set; }

    [Parameter] public string SelectedSort { get; set; } = "featured";
    [Parameter] public EventCallback<string> OnSortChanged { get; set; }

    private async Task SelectCategory(string category)
    {
        await OnCategorySelected.InvokeAsync(category);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        await OnSearchChanged.InvokeAsync(val);
    }

    private async Task OnSortSelect(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "featured";
        await OnSortChanged.InvokeAsync(val);
    }
}